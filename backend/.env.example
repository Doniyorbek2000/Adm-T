# MUHIM (xavfsizlik): JWT_SECRET, ENCRYPTION_KEY va ADMIN_PASSWORD pastdagi
# qiymatlar FAQAT lokal ishlab chiqish uchun namuna - ular ommaga ma'lum
# bo'lgani sababli production'da ishlatilsa, foydalanuvchi sessiyalari va
# shifrlangan birja API kalitlari (apiKeyEncrypted/apiSecretEncrypted) osongina
# buzilishi mumkin. Production'ga chiqishdan oldin har birini quyidagicha
# generatsiya qilingan kuchli, tasodifiy qiymat bilan almashtiring:
#   openssl rand -hex 32
# DIQQAT: ENCRYPTION_KEY'ni o'zgartirsangiz, u bilan ilgari shifrlangan barcha
# birja kalitlari o'qib bo'lmas holga keladi - foydalanuvchilar hisoblarini
# qaytadan ulashlari kerak bo'ladi (shuning uchun buni faqat ishga tushirishdan
# OLDIN, real foydalanuvchi ma'lumotlari paydo bo'lmasdan oldin qiling).
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-super-secret-key"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"
ADMIN_EMAIL="admin@admtrading.uz"
ADMIN_PASSWORD="Admin123!"
CORS_ORIGIN="http://localhost:3000"

# "testnet" = Binance sinov muhiti (sun'iy mablag', xavfsiz). "live" ga
# o'tkazishdan oldin to'liq sinab ko'ring - bu REAL pul bilan ishlaydi!
EXCHANGE_MODE="testnet"

# Ommaviy bozor ma'lumotlari (klines/narx/spread) manbasi. Server mintaqasi
# Binance tomonidan geo-bloklangan bo'lsa (HTTP 451), rasmiy ko'zguni qo'ying:
# BINANCE_PUBLIC_API="https://data-api.binance.vision"

# Futures leverage (1-20, standart 3 - konservativ). Pozitsiya o'lchamini
# baribir risk-menejer boshqaradi; katta leverage = katta likvidatsiya xavfi.
FUTURES_LEVERAGE=3

# Telegram xabarnomalar (ixtiyoriy, tavsiya etiladi):
# 1) @BotFather'da bot yarating -> tokenni pastga qo'ying
# 2) Botga /start yozing, keyin chat id oling:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# To'lov tizimi: "test" (simulyatsiya), "click" (Click.uz) yoki "payme" (Payme.uz)
PAYMENT_MODE="test"
# Click.uz (https://my.click.uz dan oling)
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
# Payme.uz (https://merchant.paycom.uz dan oling)
PAYME_MERCHANT_ID=""
PAYME_KEY=""

# MetaApi.cloud (MT5 ko'prigi) — https://app.metaapi.cloud dan token oling
METAAPI_TOKEN=""
